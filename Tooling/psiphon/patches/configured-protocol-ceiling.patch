+func TestApplyConfiguredTunnelProtocolCeiling(t *testing.T) {
+	tests := []struct {
+		name       string
+		tactics    protocol.TunnelProtocols
+		configured protocol.TunnelProtocols
+		expected   protocol.TunnelProtocols
+	}{
+		{
+			name:       "no configured ceiling preserves tactics",
+			tactics:    protocol.TunnelProtocols{"OSSH", "INPROXY-WEBRTC-OSSH"},
+			configured: nil,
+			expected:   protocol.TunnelProtocols{"OSSH", "INPROXY-WEBRTC-OSSH"},
+		},
+		{
+			name:       "intersection preserves tactics order",
+			tactics:    protocol.TunnelProtocols{"INPROXY-WEBRTC-OSSH", "FRONTED-MEEK-CDN-OSSH"},
+			configured: protocol.TunnelProtocols{"FRONTED-MEEK-CDN-OSSH", "FRONTED-MEEK-CDN-QUIC-OSSH"},
+			expected:   protocol.TunnelProtocols{"FRONTED-MEEK-CDN-OSSH"},
+		},
+		{
+			name:       "disjoint tactics cannot replace fixed transport",
+			tactics:    protocol.TunnelProtocols{"INPROXY-WEBRTC-OSSH"},
+			configured: protocol.TunnelProtocols{"FRONTED-MEEK-CDN-OSSH", "FRONTED-MEEK-CDN-QUIC-OSSH"},
+			expected:   protocol.TunnelProtocols{"FRONTED-MEEK-CDN-OSSH", "FRONTED-MEEK-CDN-QUIC-OSSH"},
+		},
+		{
+			name:       "empty tactics uses fixed transport",
+			tactics:    nil,
+			configured: protocol.TunnelProtocols{"TLS-OSSH"},
+			expected:   protocol.TunnelProtocols{"TLS-OSSH"},
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			actual := applyConfiguredTunnelProtocolCeiling(test.tactics, test.configured)
+			if !reflect.DeepEqual(actual, test.expected) {
+				t.Fatalf("unexpected protocols: got %v, expected %v", actual, test.expected)
+			}
+		})
+	}
+}
