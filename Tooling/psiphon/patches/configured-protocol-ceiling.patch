 }
 
+// applyConfiguredTunnelProtocolCeiling keeps an explicit client transport
+// selection authoritative after tactics have been applied. Tactics still
+// provide current servers, fronting data, and all unrelated parameters, but a
+// tactics LimitTunnelProtocols value cannot switch a fixed CDN/direct/conduit
+// attempt to a protocol outside the client configuration.
+func applyConfiguredTunnelProtocolCeiling(
+	tacticsLimit protocol.TunnelProtocols,
+	configuredLimit protocol.TunnelProtocols) protocol.TunnelProtocols {
+
+	if len(configuredLimit) == 0 {
+		return tacticsLimit
+	}
+
+	constrained := make(protocol.TunnelProtocols, 0, len(tacticsLimit))
+	for _, tunnelProtocol := range tacticsLimit {
+		if common.Contains(configuredLimit, tunnelProtocol) {
+			constrained = append(constrained, tunnelProtocol)
+		}
+	}
+	if len(constrained) > 0 {
+		return constrained
+	}
+
+	// An empty or disjoint tactics limit must not disable the user's fixed
+	// transport attempt. Fall back to the configured ceiling itself.
+	return append(protocol.TunnelProtocols(nil), configuredLimit...)
+}
