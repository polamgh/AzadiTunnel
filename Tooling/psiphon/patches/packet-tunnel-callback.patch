+	client.Start()
+
+	var waitGroup sync.WaitGroup
+	waitGroup.Add(2)
+	go func() {
+		defer waitGroup.Done()
+		client.Stop()
+	}()
+	go func() {
+		defer waitGroup.Done()
+		client.Stop()
+	}()
+	waitGroup.Wait()
+}
