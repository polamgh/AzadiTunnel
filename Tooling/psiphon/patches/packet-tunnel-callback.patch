+
+package psi
+
+import (
+	"errors"
+	"sync"
+	"sync/atomic"
+	"testing"
+)
+
+type testPacketProvider struct {
+	readPacket  []byte
+	readError   error
+	writeError  error
+	closeCount  atomic.Int32
+	mutex       sync.Mutex
+	states      []string
+	diagnostics []testPacketTunnelDiagnostic
+}
+
+type testPacketTunnelDiagnostic struct {
+	stage   string
+	packets int64
+	bytes   int64
+}
+
+func (provider *testPacketProvider) PacketTunnelMTU() int { return 1500 }
+
+func (provider *testPacketProvider) ReadPacket() ([]byte, error) {
+	return provider.readPacket, provider.readError
+}
+
+func (provider *testPacketProvider) WritePacket([]byte) error {
+	return provider.writeError
+}
+
+func (provider *testPacketProvider) ClosePacketTunnel() {
+	provider.closeCount.Add(1)
+}
+
+func (provider *testPacketProvider) PacketTunnelTransportState(state string) {
+	provider.mutex.Lock()
+	provider.states = append(provider.states, state)
+	provider.mutex.Unlock()
+}
+
+func (provider *testPacketProvider) PacketTunnelDiagnostic(
+	stage string, packetCount int64, byteCount int64) {
+
+	provider.mutex.Lock()
+	provider.diagnostics = append(provider.diagnostics, testPacketTunnelDiagnostic{
+		stage:   stage,
+		packets: packetCount,
+		bytes:   byteCount,
+	})
+	provider.mutex.Unlock()
+}
+
+func newTestPacketTunnelDevice(provider *testPacketProvider) *packetTunnelDevice {
+	return &packetTunnelDevice{
+		provider:    provider,
+		mtu:         provider.PacketTunnelMTU(),
+		diagnostics: newPacketTunnelDiagnostics(provider),
+	}
+}
+
+func TestPacketTunnelDevicePropagatesIOErrors(t *testing.T) {
+	readError := errors.New("read failed")
+	writeError := errors.New("write failed")
+	provider := &testPacketProvider{readError: readError, writeError: writeError}
+	device := newTestPacketTunnelDevice(provider)
+
+	if _, err := device.ReadPacket(); !errors.Is(err, readError) {
+		t.Fatalf("ReadPacket error = %v, want %v", err, readError)
+	}
+	if err := device.WritePacket([]byte{0x45}); !errors.Is(err, writeError) {
+		t.Fatalf("WritePacket error = %v, want %v", err, writeError)
+	}
+}
+
+func TestPacketTunnelDeviceConcurrentCloseCallsProviderOnce(t *testing.T) {
+	provider := &testPacketProvider{}
+	device := newTestPacketTunnelDevice(provider)
+
+	var waitGroup sync.WaitGroup
+	waitGroup.Add(32)
+	for i := 0; i < 32; i++ {
+		go func() {
+			defer waitGroup.Done()
+			if err := device.Close(); err != nil {
+				t.Errorf("Close failed: %v", err)
+			}
+		}()
+	}
+	waitGroup.Wait()
+
+	if count := provider.closeCount.Load(); count != 1 {
+		t.Fatalf("ClosePacketTunnel called %d times, want 1", count)
+	}
+}
+
+func TestPacketTunnelDeviceReportsPowerOfTwoCountersAndMTU(t *testing.T) {
+	packet := make([]byte, 1280)
+	packet[0] = 0x60
+	provider := &testPacketProvider{readPacket: packet}
+	device := newTestPacketTunnelDevice(provider)
+
+	for i := 0; i < 4; i++ {
+		if _, err := device.ReadPacket(); err != nil {
+			t.Fatalf("ReadPacket failed: %v", err)
+		}
+		if err := device.WritePacket(packet); err != nil {
+			t.Fatalf("WritePacket failed: %v", err)
+		}
+	}
+
+	provider.mutex.Lock()
+	defer provider.mutex.Unlock()
+	if len(provider.diagnostics) != 6 {
+		t.Fatalf("diagnostic callback count = %d, want 6", len(provider.diagnostics))
+	}
+	wantCounts := []int64{1, 1, 2, 2, 4, 4}
+	wantStages := []string{
+		"go_callback_read", "go_callback_write",
+		"go_callback_read", "go_callback_write",
+		"go_callback_read", "go_callback_write",
+	}
+	for index, diagnostic := range provider.diagnostics {
+		if diagnostic.packets != wantCounts[index] {
+			t.Fatalf("diagnostic %d packets = %d, want %d", index, diagnostic.packets, wantCounts[index])
+		}
+		if diagnostic.stage != wantStages[index] {
+			t.Fatalf("diagnostic %d stage = %q, want %q", index, diagnostic.stage, wantStages[index])
+		}
+	}
+	if device.PacketTunnelMTU() != 1500 {
+		t.Fatalf("PacketTunnelMTU = %d, want 1500", device.PacketTunnelMTU())
+	}
+}
+
+func TestPacketTunnelDeviceRejectsPacketsAboveMTU(t *testing.T) {
+	provider := &testPacketProvider{readPacket: make([]byte, 1501)}
+	device := newTestPacketTunnelDevice(provider)
+
+	if _, err := device.ReadPacket(); err == nil {
+		t.Fatal("ReadPacket accepted an oversized packet")
+	}
+	if err := device.WritePacket(make([]byte, 1501)); err == nil {
+		t.Fatal("WritePacket accepted an oversized packet")
+	}
+}
+
+func TestPacketTunnelDeviceReportsExplicitDropCounters(t *testing.T) {
+	provider := &testPacketProvider{}
+	device := newTestPacketTunnelDevice(provider)
+
+	for i := 0; i < 4; i++ {
+		device.RecordPacketDiagnostic("go_upstream_queue_drop", 1, 100)
+		device.RecordPacketDiagnostic("go_transport_write_drop", 2, 200)
+	}
+
+	provider.mutex.Lock()
+	defer provider.mutex.Unlock()
+	wantStages := []string{
+		"go_upstream_queue_drop", "go_transport_write_drop",
+		"go_upstream_queue_drop", "go_transport_write_drop",
+		"go_upstream_queue_drop", "go_transport_write_drop",
+	}
+	wantCounts := []int64{1, 2, 2, 4, 4, 8}
+	if len(provider.diagnostics) != len(wantStages) {
+		t.Fatalf("diagnostic callback count = %d, want %d", len(provider.diagnostics), len(wantStages))
+	}
+	for index, diagnostic := range provider.diagnostics {
+		if diagnostic.stage != wantStages[index] || diagnostic.packets != wantCounts[index] {
+			t.Fatalf(
+				"diagnostic %d = (%q, %d), want (%q, %d)",
+				index, diagnostic.stage, diagnostic.packets, wantStages[index], wantCounts[index])
+		}
+	}
+}

