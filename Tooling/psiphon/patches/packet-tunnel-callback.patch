+}
+
+func TestClientConcurrentStopClosesPacketDevice(t *testing.T) {
+	packetDevice := newBlockingPacketTunnelDevice()
+	transport := newBlockingPacketTunnelTransport()
+	client, err := NewClient(&ClientConfig{
+		Logger:       testutils.NewTestLogger(),
+		PacketDevice: packetDevice,
+		Transport:    transport,
+	})
+	if err != nil {
+		t.Fatalf("NewClient failed: %v", err)
+	}
+	client.Start()
+
+	var waitGroup sync.WaitGroup
+	waitGroup.Add(2)
+	go func() {
+		defer waitGroup.Done()
+		client.Stop()
+	}()
+	go func() {
+		defer waitGroup.Done()
+		client.Stop()
+	}()
+	waitGroup.Wait()
+}
+
+func TestClientPacketDeviceFailureIsTerminalAndReportedOnce(t *testing.T) {
+	readError := errors.New("callback device failed")
+	packetDevice := &failingPacketTunnelDevice{readError: readError}
+	transport := newBlockingPacketTunnelTransport()
+	failureCount := atomic.Int32{}
+	failureReported := make(chan error, 1)
+	client, err := NewClient(&ClientConfig{
+		Logger:       testutils.NewTestLogger(),
+		PacketDevice: packetDevice,
+		Transport:    transport,
+		PacketDeviceFailure: func(err error) {
+			failureCount.Add(1)
+			failureReported <- err
+		},
+	})
+	if err != nil {
+		t.Fatalf("NewClient failed: %v", err)
+	}
+	client.Start()
+
+	select {
+	case reportedError := <-failureReported:
+		if !errors.Is(reportedError, readError) {
+			t.Fatalf("failure error = %v, want %v", reportedError, readError)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("packet device failure was not reported")
+	}
+
+	time.Sleep(20 * time.Millisecond)
+	if count := failureCount.Load(); count != 1 {
+		t.Fatalf("failure callback count = %d, want 1", count)
+	}
+	client.Stop()
+	if !packetDevice.closed.Load() {
+		t.Fatal("Stop did not close failed packet device")
+	}
+}
