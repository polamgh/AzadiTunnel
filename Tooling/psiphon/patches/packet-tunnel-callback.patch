+func countFramedPackets(packetBuffer []byte) (int64, int64) {
+	var packetCount int64
+	var byteCount int64
+	for offset := 0; offset+channelHeaderSize <= len(packetBuffer); {
+		size := int(binary.BigEndian.Uint16(packetBuffer[offset : offset+channelHeaderSize]))
+		offset += channelHeaderSize
+		if size < 0 || offset+size > len(packetBuffer) {
+			break
+		}
+		packetCount++
+		byteCount += int64(size)
+		offset += size
+	}
+	return packetCount, byteCount
+}
