+
+type blockingPacketTunnelDevice struct {
+	closed    chan struct{}
+	closeOnce sync.Once
+}
+
+type failingPacketTunnelDevice struct {
+	readError error
+	closed    atomic.Bool
+}
+
+func (device *failingPacketTunnelDevice) ReadPacket() ([]byte, error) {
+	return nil, device.readError
+}
+
+func (device *failingPacketTunnelDevice) WritePacket([]byte) error { return nil }
+
+func (device *failingPacketTunnelDevice) Close() error {
+	device.closed.Store(true)
+	return nil
+}
+
+func newBlockingPacketTunnelDevice() *blockingPacketTunnelDevice {
+	return &blockingPacketTunnelDevice{closed: make(chan struct{})}
+}
+
+func (device *blockingPacketTunnelDevice) ReadPacket() ([]byte, error) {
+	<-device.closed
+	return nil, errors.New("packet device closed")
+}
+
+func (device *blockingPacketTunnelDevice) WritePacket([]byte) error {
+	select {
+	case <-device.closed:
+		return errors.New("packet device closed")
+	default:
+		return nil
+	}
+}
+
+func (device *blockingPacketTunnelDevice) Close() error {
+	device.closeOnce.Do(func() { close(device.closed) })
+	return nil
+}
+
+type blockingPacketTunnelTransport struct {
+	closed    chan struct{}
+	closeOnce sync.Once
+}
+
+func newBlockingPacketTunnelTransport() *blockingPacketTunnelTransport {
+	return &blockingPacketTunnelTransport{closed: make(chan struct{})}
+}
+
+func (transport *blockingPacketTunnelTransport) Read([]byte) (int, error) {
+	<-transport.closed
+	return 0, errors.New("transport closed")
+}
+
+func (transport *blockingPacketTunnelTransport) Write(packet []byte) (int, error) {
+	select {
+	case <-transport.closed:
+		return 0, errors.New("transport closed")
+	default:
+		return len(packet), nil
+	}
+}
+
+func (transport *blockingPacketTunnelTransport) Close() error {
+	transport.closeOnce.Do(func() { close(transport.closed) })
+	return nil
+}
+
+func (device *testPacketTunnelDevice) ReadPacket() ([]byte, error) {
+	return device.readPacket, nil
+}
+
+func (device *testPacketTunnelDevice) WritePacket(packet []byte) error {
+	device.wrotePacket = append([]byte(nil), packet...)
+	return nil
+}
+
+func (device *testPacketTunnelDevice) Close() error {
+	device.closed = true
+	return nil
+}
