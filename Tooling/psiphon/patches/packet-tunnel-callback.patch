+// PsiphonPacketTunnelProvider is the public raw-packet boundary used by the
+// iOS Network Extension adapter. Packets are complete IPv4 or IPv6 packets;
+// no platform tun file descriptor or tun header is involved. ReadPacket may
+// block until the host packet flow provides a packet, and ClosePacketTunnel
+// must interrupt blocked calls.
+type PsiphonPacketTunnelProvider interface {
+	PacketTunnelMTU() int
+	ReadPacket() ([]byte, error)
+	WritePacket(packet []byte) error
+	ClosePacketTunnel()
+	PacketTunnelTransportState(state string)
+	PacketTunnelDiagnostic(stage string, packetCount int64, byteCount int64)
+}
+
+type packetTunnelDevice struct {
+	provider    PsiphonPacketTunnelProvider
+	mtu         int
+	diagnostics *packetTunnelDiagnostics
+	closeOnce   sync.Once
+}
+
+type packetTunnelDiagnosticCounter struct {
+	packets atomic.Int64
+	bytes   atomic.Int64
+}
+
+type packetTunnelDiagnostics struct {
+	provider                  PsiphonPacketTunnelProvider
+	goCallbackRead            packetTunnelDiagnosticCounter
+	goCallbackWrite           packetTunnelDiagnosticCounter
+	goUpstreamValidated       packetTunnelDiagnosticCounter
+	goUpstreamEnqueued        packetTunnelDiagnosticCounter
+	goUpstreamQueueDrop       packetTunnelDiagnosticCounter
+	goTransportUpstreamWrite  packetTunnelDiagnosticCounter
+	goTransportWriteDrop      packetTunnelDiagnosticCounter
+	goTransportDownstreamRead packetTunnelDiagnosticCounter
+	goDownstreamValidated     packetTunnelDiagnosticCounter
+	goDownstreamDelivered     packetTunnelDiagnosticCounter
+}
+
+func newPacketTunnelDiagnostics(provider PsiphonPacketTunnelProvider) *packetTunnelDiagnostics {
+	return &packetTunnelDiagnostics{
+		provider: provider,
+	}
+}
+
+func (diagnostics *packetTunnelDiagnostics) record(stage string, packetCount, byteCount int64) {
+	var counter *packetTunnelDiagnosticCounter
+	switch stage {
+	case "go_callback_read":
+		counter = &diagnostics.goCallbackRead
+	case "go_callback_write":
+		counter = &diagnostics.goCallbackWrite
+	case "go_upstream_validated":
+		counter = &diagnostics.goUpstreamValidated
+	case "go_upstream_enqueued":
+		counter = &diagnostics.goUpstreamEnqueued
+	case "go_upstream_queue_drop":
+		counter = &diagnostics.goUpstreamQueueDrop
+	case "go_transport_upstream_write":
+		counter = &diagnostics.goTransportUpstreamWrite
+	case "go_transport_write_drop":
+		counter = &diagnostics.goTransportWriteDrop
+	case "go_transport_downstream_read":
+		counter = &diagnostics.goTransportDownstreamRead
+	case "go_downstream_validated":
+		counter = &diagnostics.goDownstreamValidated
+	case "go_downstream_delivered":
+		counter = &diagnostics.goDownstreamDelivered
+	default:
+		return
+	}
+
+	packets := counter.packets.Add(packetCount)
+	bytes := counter.bytes.Add(byteCount)
+	shouldReport := packets == 1 ||
+		(packets > 0 && packets&(packets-1) == 0)
+
+	if shouldReport {
+		diagnostics.provider.PacketTunnelDiagnostic(
+			stage, packets, bytes)
+	}
+}
+
+func (device *packetTunnelDevice) ReadPacket() ([]byte, error) {
+	packet, err := device.provider.ReadPacket()
+	if err != nil {
+		return nil, err
+	}
+	if len(packet) > device.mtu {
+		return nil, errors.Tracef(
+			"packet tunnel provider read exceeds MTU: %d > %d", len(packet), device.mtu)
+	}
+	device.diagnostics.record("go_callback_read", 1, int64(len(packet)))
+	return packet, nil
+}
+
+func (device *packetTunnelDevice) WritePacket(packet []byte) error {
+	if len(packet) > device.mtu {
+		return errors.Tracef(
+			"packet tunnel provider write exceeds MTU: %d > %d", len(packet), device.mtu)
+	}
+	if err := device.provider.WritePacket(packet); err != nil {
+		return err
+	}
+	device.diagnostics.record("go_callback_write", 1, int64(len(packet)))
+	return nil
+}
+
+func (device *packetTunnelDevice) Close() error {
+	device.closeOnce.Do(device.provider.ClosePacketTunnel)
+	return nil
+}
+
+func (device *packetTunnelDevice) PacketTunnelMTU() int {
+	return device.mtu
+}
+
+func (device *packetTunnelDevice) ReportPacketTunnelState(state string) {
+	device.provider.PacketTunnelTransportState(state)
+}
+
+func (device *packetTunnelDevice) RecordPacketDiagnostic(
+	stage string, packetCount, byteCount int64) {
+
+	device.diagnostics.record(stage, packetCount, byteCount)
+}
