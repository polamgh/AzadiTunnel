+type testPacketTunnelDevice struct {
+	readPacket  []byte
+	wrotePacket []byte
+	closed      bool
+}
+
+type blockingPacketTunnelDevice struct {
+	closed    chan struct{}
+	closeOnce sync.Once
+}
+
+func newBlockingPacketTunnelDevice() *blockingPacketTunnelDevice {
+	return &blockingPacketTunnelDevice{closed: make(chan struct{})}
+}
+
+func (device *blockingPacketTunnelDevice) ReadPacket() ([]byte, error) {
+	<-device.closed
+	return nil, errors.New("packet device closed")
+}
+
+func (device *blockingPacketTunnelDevice) WritePacket([]byte) error {
+	select {
+	case <-device.closed:
+		return errors.New("packet device closed")
+	default:
+		return nil
+	}
+}
+
+func (device *blockingPacketTunnelDevice) Close() error {
+	device.closeOnce.Do(func() { close(device.closed) })
+	return nil
+}
+
+type blockingPacketTunnelTransport struct {
+	closed    chan struct{}
+	closeOnce sync.Once
+}
+
+func newBlockingPacketTunnelTransport() *blockingPacketTunnelTransport {
+	return &blockingPacketTunnelTransport{closed: make(chan struct{})}
+}
+
+func (transport *blockingPacketTunnelTransport) Read([]byte) (int, error) {
+	<-transport.closed
+	return 0, errors.New("transport closed")
+}
+
+func (transport *blockingPacketTunnelTransport) Write(packet []byte) (int, error) {
+	select {
+	case <-transport.closed:
+		return 0, errors.New("transport closed")
+	default:
+		return len(packet), nil
+	}
+}
+
+func (transport *blockingPacketTunnelTransport) Close() error {
+	transport.closeOnce.Do(func() { close(transport.closed) })
+	return nil
+}
+
+func (device *testPacketTunnelDevice) ReadPacket() ([]byte, error) {
+	return device.readPacket, nil
+}
+
+func (device *testPacketTunnelDevice) WritePacket(packet []byte) error {
+	device.wrotePacket = append([]byte(nil), packet...)
+	return nil
+}
+
+func (device *testPacketTunnelDevice) Close() error {
+	device.closed = true
+	return nil
+}
+
+func TestClientDeviceFromPacketDeviceUsesRawPackets(t *testing.T) {
+	input := []byte{0x60, 0x00, 0x00, 0x00, 0x00, 0x08, 0x11, 0x40}
+	packetDevice := &testPacketTunnelDevice{readPacket: input}
+
+	device, err := NewClientDeviceFromPacketDevice(&ClientConfig{
+		PacketDevice: packetDevice,
+	})
+	if err != nil {
+		t.Fatalf("NewClientDeviceFromPacketDevice failed: %v", err)
+	}
+
+	packet, err := device.ReadPacket()
+	if err != nil {
+		t.Fatalf("ReadPacket failed: %v", err)
+	}
+	if !bytes.Equal(packet, input) {
+		t.Fatalf("ReadPacket returned %x, want %x", packet, input)
+	}
+
+	output := []byte{0x45, 0x00, 0x00, 0x14, 0x00, 0x00, 0x40, 0x00}
+	if err := device.WritePacket(output); err != nil {
+		t.Fatalf("WritePacket failed: %v", err)
+	}
+	if !bytes.Equal(packetDevice.wrotePacket, output) {
+		t.Fatalf("WritePacket sent %x, want %x", packetDevice.wrotePacket, output)
+	}
+
+	if err := device.Close(); err != nil {
+		t.Fatalf("Close failed: %v", err)
+	}
+	if !packetDevice.closed {
+		t.Fatal("Close did not close the callback device")
+	}
+}
+
+func TestClientDeviceFromPacketDeviceCloseInterruptsRead(t *testing.T) {
+	packetDevice := newBlockingPacketTunnelDevice()
+	device, err := NewClientDeviceFromPacketDevice(&ClientConfig{PacketDevice: packetDevice})
+	if err != nil {
+		t.Fatalf("NewClientDeviceFromPacketDevice failed: %v", err)
+	}
+
+	readResult := make(chan error, 1)
+	go func() {
+		_, readErr := device.ReadPacket()
+		readResult <- readErr
+	}()
+
+	if err := device.Close(); err != nil {
+		t.Fatalf("Close failed: %v", err)
+	}
+	select {
+	case readErr := <-readResult:
+		if readErr == nil || !strings.Contains(readErr.Error(), "packet device closed") {
+			t.Fatalf("ReadPacket error = %v, want close error", readErr)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("ReadPacket remained blocked after Close")
+	}
+}
+
+func TestClientConcurrentStopClosesPacketDevice(t *testing.T) {
+	packetDevice := newBlockingPacketTunnelDevice()
+	transport := newBlockingPacketTunnelTransport()
+	client, err := NewClient(&ClientConfig{
+		Logger:       testutils.NewTestLogger(),
